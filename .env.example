# SkyBar POS — environment variables
# Restart Next.js after changing this file: npm run dev

# ─── API (Spring Boot on Mac) ───────────────────────────────────────────────
# Browser calls same-origin /api (proxied by Next.js — no CORS).
# These vars are for the Next.js server proxy target + SSR:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api
API_PROXY_TARGET=http://127.0.0.1:8080

# ─── Frontend URLs ────────────────────────────────────────────────────────────
# Mac:   http://localhost:4028
# Phone: http://172.19.13.248:4028  (dev server binds 0.0.0.0 — see package.json)

# If your Mac IP changes, update this value and backend application.yml CORS origins.

NEXT_PUBLIC_SITE_URL=https://skybarpos2848.builtwithrocket.new
