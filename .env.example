# Copy to .env and fill in. Never commit .env.

# Browser uses same-origin /api (Next.js proxy). Server-side / SSR target:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api
API_PROXY_TARGET=http://127.0.0.1:8080

# Optional: allow a specific LAN host in Next.js allowedDevOrigins (hostname only)
# DEV_LAN_ORIGIN=172.20.15.99
# NEXT_PUBLIC_SITE_URL=http://172.20.15.99:4028
